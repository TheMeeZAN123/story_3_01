<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/back_arrow"
            android:layout_marginEnd="16dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manage Counselors"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add, edit, or manage counselor accounts"
                android:textSize="13sp"
                android:textColor="@color/text_gray"/>

        </LinearLayout>

        <Button
            android:id="@+id/addCounselorBtn"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="+ Add Counselor"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:background="@drawable/sign_in_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>

    </LinearLayout>

    <!-- search -->
    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Search by name or expertise..."
        android:inputType="text"
        android:background="@drawable/input_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textSize="14sp"
        android:drawablePadding="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"/>

    <!-- column headers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@color/background">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="COUNSELOR"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_gray"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXPERTISE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_gray"/>

    </LinearLayout>

    <!-- counselors list -->
    <ListView
        android:id="@+id/counselorsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:clipToPadding="false"/>

    <!-- no counselors, empty state -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No counselors found"
            android:textSize="14sp"
            android:textColor="@color/text_gray"/>

    </LinearLayout>

</LinearLayout>