<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- top section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/back_arrow"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirm Booking"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"/>

        </LinearLayout>

        <!-- top icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_calender_white"
                android:background="@drawable/circle_blue"
                android:padding="20dp"/>

        </LinearLayout>

        <!-- appointment details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appointment Details"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:layout_marginBottom="16dp"/>

            <!-- counselor,date, time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_user"
                    android:background="@drawable/icon_bg_blue"
                    android:padding="8dp"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Counselor"
                        android:textSize="12sp"
                        android:textColor="@color/text_gray"/>

                    <TextView
                        android:id="@+id/confirmCounselorName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dr. Sarah Johnson"
                        android:textSize="15sp"
                        android:textColor="@color/text_dark"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_calender"
                    android:background="@drawable/icon_bg_green"
                    android:padding="8dp"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date"
                        android:textSize="12sp"
                        android:textColor="@color/text_gray"/>

                    <TextView
                        android:id="@+id/confirmDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2026-03-10"
                        android:textSize="15sp"
                        android:textColor="@color/text_dark"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_clock"
                    android:background="@drawable/icon_bg_purple"
                    android:padding="8dp"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Time"
                        android:textSize="12sp"
                        android:textColor="@color/text_gray"/>

                    <TextView
                        android:id="@+id/confirmTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10:00 AM"
                        android:textSize="15sp"
                        android:textColor="@color/text_dark"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- confirm -->
        <Button
            android:id="@+id/confirmBookingBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Confirm Booking"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:background="@drawable/sign_in_bg"
            android:layout_marginBottom="12dp"/>

        <!-- cancel -->
        <Button
            android:id="@+id/cancelBookingBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Cancel"
            android:textSize="16sp"
            android:textColor="@color/primary_blue"
            android:background="@drawable/button_outline"/>

    </LinearLayout>

</ScrollView>